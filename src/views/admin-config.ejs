<!-- src/views/admin-config.ejs -->
<%- include('partials/head') %>
<%- include('partials/header') %>

  <h1 class="display-title">Configuration</h1>

  <% if (typeof msg !== 'undefined' && msg) { %>
    <p class="flash <%= (typeof err !== 'undefined' && err) ? 'flash-err' : 'flash-ok' %>" role="status"><%= msg %></p>
  <% } %>

  <%# data-date-range marks this form as the one src/public/js/date-field.js
      wires its start/end pair inside (issue #875).

      novalidate is deliberate, and it switches off native validation for this
      WHOLE form, not just the date pair. The trade it makes, what
      date-field.js hands back, and what stays given up with scripts off are
      argued in DESIGN.md's ADR "One date-field component, styled native
      input type=date (#875)". %>
  <form action="/admin/config" method="POST" autocomplete="off" novalidate data-date-range>
    <%- include('partials/csrf-field') %>
    <div class="form-row">
      <label class="form-label" for="timezone">Event timezone</label>
      <select id="timezone" name="timezone">
        <% timezones.forEach(function (z) { %>
          <option value="<%= z[0] %>"<%= z[0] === config.timezone ? ' selected' : '' %>><%= z[1] %></option>
        <% }); %>
      </select>
    </div>

    <%- include('partials/date-field', {
          id: 'start_date',
          name: 'start_date',
          label: 'Wedding starts',
          value: config.startDate,
          rangeRole: 'start'
        }) %>

    <%# The end field's `min` is the stored start date on this render;
        date-field.js re-pins it whenever the start field changes. Client-side
        bounds only — src/routes/admin/config.js still rejects an inverted pair
        on a crafted POST. %>
    <%- include('partials/date-field', {
          id: 'end_date',
          name: 'end_date',
          label: 'Wedding ends',
          value: config.endDate,
          min: config.startDate,
          rangeRole: 'end'
        }) %>
    <p class="form-error date-range-error" role="alert" data-range-error hidden></p>

    <div class="form-row">
      <label class="form-label" for="prizes">Prizes</label>
      <textarea id="prizes" name="prizes" rows="4" maxlength="<%= prizesMaxLength %>"
                placeholder="One prize per line — shown to guests at the top of the leaderboard"><%= prizes %></textarea>
      <p class="field-hint config-prizes-hint">Guests see this above the standings, word for word. Leave it blank and no prizes appear anywhere.</p>
    </div>

    <div class="form-row">
      <label class="config-rule-check">
        <input type="checkbox" id="ceremony_notice" name="ceremony_notice" value="1"<%= config.ceremonyNotice ? ' checked' : '' %>>
        <span class="config-rule-label">Warn guests: no photos during the ceremony</span>
      </label>
      <p class="form-help">
        Adds the rule to the guest onboarding screen, and on the ceremony day shows a red
        line on every guest page plus one notification, each linking to a short explainer.
      </p>
    </div>

    <div class="form-row">
      <label class="form-label" for="ceremony_date">Ceremony day</label>
      <input class="form-input" type="date" id="ceremony_date" name="ceremony_date" value="<%= config.ceremonyDate %>">
    </div>

    <button class="btn--primary" type="submit">Save configuration</button>
  </form>

  <script src="/js/date-field.js" defer></script>

<%- include('partials/footer') %>
