<!-- src/views/admin-guests.ejs -->
<%- include('partials/head') %>
<%- include('partials/header') %>

  <h1 class="display-title">Guests</h1>

  <% if (msg) { %>
    <p class="flash"><%= msg %></p>
  <% } %>

  <%# No "back to Dashboard" link and no "Print entry poster" button (owner,
      2026-08-03). The top nav already carries Dashboard and Poster, and a
      back link assumes the host arrived from the dashboard, which they
      usually did not. %>
  <input type="search" id="guest-search" class="form-input guest-search"
         placeholder="Search guests by name&hellip;" autocomplete="off"
         aria-label="Search guests by name" />

  <h2 class="guest-list-heading">Guests <span class="muted">(<%= guests.length %>)</span></h2>

  <ul class="guest-list" id="guest-list">
    <% guests.forEach(function (g) { %>
      <li class="guest-card <%= g.blocked ? 'is-blocked' : '' %>" id="guest-<%= g.id %>"
          data-guest-name="<%= g.name %>"
          data-guest-id="<%= g.id %>"
          data-name="<%= g.name %>"
          data-contact="<%= g.contact %>"
          data-pin="<%= g.pin %>"
          data-couple="<%= g.is_couple ? '1' : '0' %>"
          data-blocked="<%= g.blocked ? '1' : '0' %>"
          data-stats="<%= g.points %> pts &middot; <%= g.completed %> of <%= totalTasks %> tasks">
        <%# The whole row opens the popup — one tap, no separate Edit button
            (owner, 2026-08-03). The way to that guest's photos is a link
            inside the popup rather than on this row: a link cannot live
            inside a button, so putting both here would have cost the row its
            single-tap behavior. %>
        <%# No data-photos-url here: admin-guests.js composes that link from
            data-name instead. An href handed whole to JS out of the DOM is a
            sink that can be pointed anywhere; composed from a literal path
            plus an encoded name, it cannot. %>
        <button type="button" class="guest-open" data-edit-guest="<%= g.id %>">
          <span class="guest-open-avatar">
            <%- include('partials/guest-avatar', { avatarPath: g.avatar_path, name: g.name }) %>
          </span>
          <span class="guest-open-body">
            <span class="guest-open-name"><%= g.name || '(no name)' %></span>
            <span class="guest-open-meta"><%= g.points %> pts &middot; <%= g.completed %> of <%= totalTasks %> tasks</span>
          </span>
        </button>
        <%# A row grows a second line only when something is actually switched
            on — so a scan down the list reads as "everyone is normal except
            these two". %>
        <% if (g.blocked || g.is_couple) { %>
          <div class="admin-chip-strip guest-chip-strip">
            <% if (g.blocked) { %>
              <span class="admin-chip admin-chip-blocked">Blocked</span>
            <% } %>
            <% if (g.is_couple) { %>
              <span class="admin-chip admin-chip-oneday">The couple</span>
            <% } %>
          </div>
        <% } %>
        <%# The real delete form, hidden. The visible Delete lives in the edit
            popup and fires this one by requestSubmit() — the same pattern
            admin-tasks.ejs uses, so admin.js's delegated data-confirm listener
            still gates it. %>
        <form action="/admin/guests/<%= g.id %>/delete" method="post"
              class="guest-delete-form" data-guest-id="<%= g.id %>"
              data-confirm="Delete <%= g.name || ('guest #' + g.id) %> and PERMANENTLY remove all their photos (files deleted from disk) and badges? This cannot be undone."
              hidden><%- include('partials/csrf-field') %></form>
      </li>
    <% }); %>
    <% if (guests.length === 0) { %>
      <li class="muted">No guests yet. They appear here as they join.</li>
    <% } %>
  </ul>

  <%- include('partials/guest-edit-dialog') %>


<script src="/js/filter.js" defer></script>
<script src="/js/admin.js" defer></script>
<%# Issue #879's single owner of backdrop-dismiss wiring — must load before
    admin-guests.js, its consumer here. %>
<script src="/js/dialog-dismiss.js" defer></script>
<script src="/js/admin-guests.js" defer></script>
<%- include('partials/footer') %>
