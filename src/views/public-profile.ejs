<!-- src/views/public-profile.ejs -->
<%- include('partials/head') %>
<%- include('partials/header') %>

  <header class="profile-header">
    <% if (profileGuest.avatar_path) { %>
      <img class="profile-avatar"
           src="/uploads/<%= profileGuest.avatar_path %>"
           alt="<%= profileGuest.name || 'Guest' %>"
           width="96" height="96" />
    <% } else { %>
      <div class="profile-avatar-empty" aria-hidden="true">
        <%= initials(profileGuest.name) || '?' %>
      </div>
    <% } %>

    <h1 class="profile-name"><%= profileGuest.name || 'Guest' %></h1>

    <% if (score && typeof score.points === 'number') { %>
      <p class="profile-points">
        <strong><%= score.points %></strong>
        pt<%= score.points === 1 ? '' : 's' %>
      </p>
    <% } %>

    <% if (socialLinks.length > 0) { %>
      <ul class="profile-socials">
        <% socialLinks.forEach(function (s) { %>
          <li>
            <%
              var _socialClass = (s.key === 'instagram' || s.key === 'facebook' || s.key === 'website')
                ? 'social-' + s.key
                : '';
            %>
            <% if (_socialClass) { %>
              <a class="<%= _socialClass %>"
                 href="<%= s.href %>"
                 target="_blank"
                 rel="noopener noreferrer nofollow">
                <%= s.label %>
              </a>
            <% } else { %>
              <a class="pill-chip"
                 href="<%= s.href %>"
                 target="_blank"
                 rel="noopener noreferrer nofollow">
                <%= s.label %>
              </a>
            <% } %>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </header>

  <section class="profile-badges">
    <h2 class="section-heading">Badges</h2>
    <% if (badges.length === 0) { %>
      <p class="muted">No badges yet.</p>
    <% } else { %>
      <ul class="badge-grid">
        <% badges.forEach(function (b) { %>
          <li class="badge-item">
            <a href="/badge/<%= b.code %>">
              <%- include('partials/badge-art', { badge: b, width: 48, height: 48 }) %>
              <span class="badge-text">
                <span class="badge-name">
                  <%= b.name %><% if (b.pointsLabel) { %> <span class="badge-points"><%= b.pointsLabel %></span><% } %>
                </span>
                <% if (b.description) { %>
                  <span class="badge-desc"><%= b.description %></span>
                <% } %>
              </span>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <section class="profile-photos">
    <h2 class="section-heading">Photos</h2>
    <%# Crowd-favorite rank lookup (issue #788): submission_id -> rank (1 is
        gold), supplied by the route from ONE scoring.crowdFavorites() call.
        Defaults to an empty lookup when a caller renders this view without
        it, so the crown mark below simply matches nothing rather than
        throwing. %>
    <% var crownRank = (typeof crownRank !== 'undefined' && crownRank) ? crownRank : {}; %>
    <%# Gold is reserved for a SINGLE champion (issue #811 AC4): the route
        derives crownGoldId from the SAME crowdFavorites() call that built
        crownRank above (community.js's crownRankState()) — the sole rank-1
        submission id when exactly one photo holds rank 1, else null.
        Defaults to null when a caller omits it, matching crownRank's own
        guard idiom. %>
    <% var crownGoldId = (typeof crownGoldId !== 'undefined') ? crownGoldId : null; %>
    <%# Task-badge victory medal lookup — same guard idiom as gallery.ejs.
        The route supplies badgeVictory from the same
        taskBadges.victoryRankBySubmission() call GET /gallery already uses,
        so the profile grid wears the same medal /gallery renders; the
        default below is a defensive fallback for a caller that omits it,
        not a placeholder awaiting future wiring. %>
    <% var badgeVictory = (typeof badgeVictory !== 'undefined' && badgeVictory) ? badgeVictory : {}; %>
    <% if (photos.length === 0) { %>
      <p class="muted">No photos shared yet.</p>
    <% } else { %>
      <div class="gallery-grid" id="galleryGrid">
        <% photos.forEach(function (p) { %>
          <%
            /* scopeToken: the server-side window this tile's feed link is
               constrained to (issue #952 AC1/AC4) — every other guest's
               photo is excluded by the feedWindow() SQL predicate, not
               filtered client-side. scopeToken is the route's own
               feed.scopeToken() result (community.js's GET /u/:guestId) —
               this view never hand-builds the 'u<id>' token itself.
               origin 'profile' (issue #954): this page IS that guest's
               public profile, so the scoped feed's back link leads back
               here (/u/<id>) regardless of whose profile this is. */
            var alt = p.task_title || 'a shared memory';
          %>
          <%- include('partials/gallery-tile', {
                thumbPath: p.thumb_path,
                id: p.submission_id,
                alt: alt,
                scopeToken: scopeToken,
                origin: 'profile',
                crownRank: crownRank,
                crownGoldId: crownGoldId,
                badgeVictory: badgeVictory
              }) %>
        <% }); %>
      </div>

      <% if (page < totalPages) { %>
        <nav class="show-more" aria-label="More photos">
          <a class="btn btn-secondary" href="/u/<%= profileGuest.id %>?page=<%= page + 1 %>">Show more</a>
        </nav>
      <% } %>
    <% } %>
  </section>

<% if (page < totalPages) { %>
  <script src="/js/gallery-more.js" defer></script>
<% } %>
<%- include('partials/footer') %>
