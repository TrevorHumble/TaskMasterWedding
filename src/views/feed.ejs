<!-- src/views/feed.ejs -->
<%- include('partials/head') %>
<%- include('partials/header') %>

  <h1 class="page-title">Feed</h1>

  <%# Crowd-favorite rank lookup (issue #788): submission_id -> rank (1 is
      gold), supplied by the route from ONE scoring.crowdFavorites() call.
      Defaults to an empty lookup when a caller renders this view without it,
      so the crown mark below simply matches nothing rather than throwing. %>
  <% var crownRank = (typeof crownRank !== 'undefined' && crownRank) ? crownRank : {}; %>

  <%# Gold is reserved for a SINGLE champion (issue #811 AC4): the route
      derives crownGoldId from the SAME crowdFavorites() call that built
      crownRank above (community.js's crownRankState()) — the sole rank-1
      submission id when exactly one photo holds rank 1, else null. Defaults
      to null when a caller omits it, matching crownRank's own guard idiom. %>
  <% var crownGoldId = (typeof crownGoldId !== 'undefined') ? crownGoldId : null; %>

  <%# Couple's-Heart lookup (issue #647): submission_id -> the names of the
      couple-flagged guests (guests.is_couple = 1) who liked that photo, in
      one grouped attach by the route — never a per-photo query. Same optional
      lookup shape crownRank above already uses, and the SAME lookup
      partials/gallery-tile.ejs takes, so the feed card and a gallery tile can
      never disagree about which photos wear the mark. Defaults to an empty
      lookup when a caller omits it, so the mark simply matches nothing. %>
  <% var coupleLikers = (typeof coupleLikers !== 'undefined' && coupleLikers) ? coupleLikers : {}; %>

  <%# Scoped-feed back-link frame (issue #954, superseding #952 AC5):
      community.js's GET /feed supplies backHref/backLabel/isScoped only for
      a valid ?scope=. isScoped is false and the other two are null on every
      other request (unscoped, or an invalid scope that already fell back to
      unscoped in feed.parseScope), which is this guard's default. isScoped
      is the one signal that gates the scoped frame and the empty-state copy
      choice below. There is no setLabel local (issue #954 AC1): the "showing
      only ___" tail this fed is gone, and the back link is the only chrome
      a scoped feed wears above its cards. %>
  <% var backHref = (typeof backHref !== 'undefined') ? backHref : null; %>
  <% var backLabel = (typeof backLabel !== 'undefined') ? backLabel : null; %>
  <% var isScoped = (typeof isScoped !== 'undefined') ? isScoped : false; %>

  <%# Issue #677: top edge for in-place loading of NEWER photos. The sentinel
      is an invisible 1px strip src/public/js/feed-scroll.js watches with an
      IntersectionObserver; the indicator is the loading ring shown while a
      newer window is being fetched (hidden otherwise). Rendered only when a
      newer page exists — appending older pages can never create one. %>
  <% if (newerHref) { %>
    <div class="feed-sentinel" id="feedSentinelNewer" aria-hidden="true"></div>
    <div class="feed-edge" id="feedEdgeNewer" hidden role="status">
      <span class="feed-edge-ring" aria-hidden="true"></span>
      <span class="visually-hidden">Loading newer photos</span>
    </div>
  <% } %>

  <%# Scoped-feed top back link (issue #954): the back link alone, immediately
      above the card list. The old "showing only ___" tail is gone: the photos
      below already are the set, so the sentence only told the guest what they
      can already see. %>
  <% if (isScoped) { %>
    <p class="muted">
      <a href="<%= backHref %>"><%= backLabel %></a>
    </p>
  <% } %>

  <% if (photos.length === 0) { %>
    <%# AC4: an empty but VALID scope (every photo in the set taken down)
        reads "No photos here yet.", in place of the cards, never the
        unscoped "be the first" copy — that line invites a share this page
        can't accept. %>
    <p class="muted"><%= isScoped ? 'No photos here yet.' : 'No photos yet. Be the first to share one!' %></p>
  <% } %>

  <%# Issue #890 AC5: the signed-in guest's own id/name/avatar are exposed
      here, once, for src/public/js/feed.js to build their own likers-dialog
      row client-side (insert on like, remove on unlike) without a round
      trip — the like-toggle response only carries { liked, likeCount }
      (POST /p/:id/like, community.js), never guest identity. %>
  <div
    class="feed"
    data-guest-id="<%= guest.id %>"
    data-guest-name="<%= guest.name || 'Guest' %>"
    data-guest-avatar="<%= guest.avatar_path || '' %>"
    data-guest-initials="<%= initials(guest.name) || '?' %>"
  >
    <% photos.forEach(function (p) {
         // Card v2 (#248): the card shows only the 4 MOST RECENT comments as
         // one-line rows ("4 lines, not 4 comments" — owner amendment). The
         // comments dialog below renders the full thread. attachComments()
         // already loads every visible comment for this photo, oldest-first,
         // so slicing the tail here needs no extra query.
         var commentTotal = p.comments.length;
         var commentPreview = p.comments.slice(-4);
         // Issue #647: the couple-flagged guests who liked this photo, in
         // like order. Empty for the overwhelming majority of photos.
         var coupleNames = coupleLikers[p.submission_id] || [];
    %>
      <article id="photo-<%= p.submission_id %>" class="feed-item">
        <div class="feed-by">
          <a class="feed-by-who" href="/u/<%= p.guest_id %>">
            <%- include('partials/guest-avatar', { avatarPath: p.guest_avatar_path, name: p.guest_name || 'Guest', size: 'sm' }) %>
            <span class="feed-by-name"><%= p.guest_name || 'Guest' %></span>
          </a>
          <%- include('partials/photo-owner-menu', { guest: guest, photo: p, captionMaxLength: captionMaxLength }) %>
        </div>

        <%# The feed shows the 400px thumbnail — the original is one tap away
            on the photo detail page (issue #194: a guest scrolling on venue
            wifi should pull kilobytes per photo, not megabytes). %>
        <%# The anchor keeps its href to /p/:id as the no-JS fallback; with JS
            on, /js/lightbox.js intercepts the tap and opens the full-res
            original in an in-place overlay instead (issue #673). The
            data-lightbox-* hooks feed that overlay; the like/comment hooks
            mark this as a guest (social) trigger. %>
        <a
          class="feed-photo-link js-lightbox"
          href="/p/<%= p.submission_id %>"
          data-lightbox-group="feed"
          data-lightbox-photo="<%= p.photo_path %>"
          data-lightbox-alt="<%= p.task_title || 'a shared memory' %>"
          data-lightbox-by="by <%= p.guest_name || 'Guest' %>"
          data-lightbox-caption="<%= p.caption || '' %>"
          data-lightbox-like-count="<%= p.like_count %>"
          data-lightbox-liked="<%= p.viewer_liked ? 'true' : 'false' %>"
          data-lightbox-comment-count="<%= p.comments.length %>"
        >
          <img
            class="feed-photo"
            src="/thumbs/<%= p.thumb_path %>"
            alt="<%= p.task_title || 'a shared memory' %>"
            loading="lazy"
          />
          <% if (crownRank[p.submission_id]) { %>
            <%- include('partials/crowd-favorite-mark', {
                  rank: crownRank[p.submission_id],
                  gold: crownGoldId !== null && p.submission_id === crownGoldId
                }) %>
          <% } %>
          <% if (coupleNames.length) { %>
            <%- include('partials/couple-heart-mark', { names: coupleNames }) %>
          <% } %>
        </a>

        <% if (p.caption) { %>
          <p class="feed-caption"><%= p.caption %></p>
        <% } %>

        <div class="feed-actionbar">
          <div class="feed-actions-left">
            <form method="post" action="/p/<%= p.submission_id %>/like" class="like-form">
              <%- include('partials/csrf-field') %>
              <button
                type="submit"
                class="like-button<%= p.viewer_liked ? ' like-button-liked' : '' %>"
                aria-pressed="<%= p.viewer_liked ? 'true' : 'false' %>"
                aria-label="Like this photo"
              >
                <svg class="like-heart" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 21s-8.5-5.3-8.5-11.2A4.8 4.8 0 0 1 12 6.6a4.8 4.8 0 0 1 8.5 3.2C20.5 15.7 12 21 12 21z"/>
                </svg>
              </button>
            </form>

            <%# Issue #890 (owner direction 2026-07-27): the count reads
                "3 likes" and is a tap target opening the likers list —
                the heart alone toggles. The pluralized word is its own
                <span> (not a bare text node) so src/public/js/feed.js can
                update it directly on toggle instead of a text-node splice;
                the aria-label mirrors the same count for a screen reader. %>
            <%# Issue #647 (owner direction 2026-08-02): when a couple-flagged
                guest liked this photo, their name leads the tally in gold and
                the rest reads "and N other likes" — the couple's attention is
                the reward, so it is what the row says first. A photo with no
                couple-like renders exactly the markup #890 already shipped.

                data-couple-count is what lets src/public/js/feed.js keep this
                row honest on a live toggle: the server's like-toggle response
                carries only { liked, likeCount }, a TOTAL, but .like-count on
                this branch shows OTHERS. Without the couple's own share
                published here, feed.js would write the total into a span
                labelled "other likes" and overcount by one per couple-liker.
                The couple's names never change on a toggle, so only the
                number and the word need re-rendering — which is why the two
                tails below are pre-rendered and toggled by `hidden` rather
                than rebuilt in JS from a second copy of this copy. %>
            <% var otherLikes = p.like_count - coupleNames.length; %>
            <button
              type="button"
              class="likes-link"
              data-open-likes="<%= p.submission_id %>"
              <% if (coupleNames.length) { %>data-couple-count="<%= coupleNames.length %>"<% } %>
              aria-label="See who liked this photo — <%= p.like_count %> like<%= p.like_count === 1 ? '' : 's' %>"
            ><% if (coupleNames.length) { %><span class="couple-likers"><%= coupleNames.join(' & ') %></span><span class="likes-link-others"<%= otherLikes > 0 ? '' : ' hidden' %>> and <span class="like-count"><%= otherLikes %></span> <span class="likes-link-word">other like<%= otherLikes === 1 ? '' : 's' %></span></span><span class="likes-link-solo"<%= otherLikes > 0 ? ' hidden' : '' %>> liked this</span><% } else { %><span class="like-count"><%= p.like_count %></span> <span class="likes-link-word">like<%= p.like_count === 1 ? '' : 's' %></span><% } %></button>

            <button
              type="button"
              class="comment-button"
              data-open-comments="<%= p.submission_id %>"
              aria-label="View and add comments"
            >
              <svg class="comment-bubble" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3C6.48 3 2 6.58 2 11c0 2.36 1.28 4.48 3.3 5.94-.11.9-.42 2.24-1.2 3.56a.5.5 0 0 0 .62.72c1.77-.64 3.13-1.5 3.99-2.13.99.24 2.05.37 3.29.37 5.52 0 10-3.58 10-8s-4.48-8-10-8z"/>
              </svg>
              <span class="comment-count"><%= commentTotal %></span>
            </button>
          </div>

          <span class="points-count"><%= p.points %> <%= p.points === 1 ? 'point' : 'points' %></span>
        </div>

        <% if (commentTotal > 0) { %>
          <div class="feed-comments">
            <% commentPreview.forEach(function (c) { %>
              <p class="feed-comment feed-comment-row">
                <a href="/u/<%= c.guest_id %>"><%= c.guest_name || 'Guest' %></a>
                <%= c.body %>
              </p>
            <% }); %>
            <button
              type="button"
              class="see-all-comments"
              data-open-comments="<%= p.submission_id %>"
            >See all <%= commentTotal %> comment<%= commentTotal === 1 ? '' : 's' %></button>
          </div>
        <% } %>

        <% if (p.task_title) { %>
          <p class="feed-task-line">
            for &ldquo;<a href="/gallery?task=<%= p.task_id %>"><%= p.task_title %></a>&rdquo;
          </p>
        <% } else { %>
          <%# A memory (issue #247, task_id IS NULL) has no task — the card's
              task line reads "a shared memory" and links nowhere (AC4). %>
          <p class="feed-task-line">a shared memory</p>
        <% } %>

        <%# Likers dialog (issue #890): who liked this photo, Instagram-style —
            same native-<dialog> shell and shape as the comments dialog below
            (header + thumb + close, top-layer so it escapes .feed-item's
            paint containment, one-dialog-at-a-time via feed.js). p.likers is
            attached server-side by attachLikers() (community.js), newest
            like first, bounded to the submissions this page actually
            renders — never a per-photo query.

            CONTRACT: the `comments-dialog` class on this <dialog> is not
            just shared styling — src/public/js/feed.js keys its mutual-
            exclusion invariant (openModalDialog's `dialog.comments-dialog
            [open]` lookup) AND its backdrop-click-to-close handler
            (`target.classList.contains('comments-dialog')`) on that exact
            class name. Renaming or dropping it here silently breaks both,
            with no test failure pointing back at this line. %>
        <dialog
          class="comments-dialog likes-dialog"
          id="likes-dialog-<%= p.submission_id %>"
          aria-labelledby="likes-dialog-title-<%= p.submission_id %>"
        >
          <div class="comments-dialog-header">
            <img class="comments-dialog-thumb" src="/thumbs/<%= p.thumb_path %>" alt="" />
            <h2 class="comments-dialog-title" id="likes-dialog-title-<%= p.submission_id %>">Likes</h2>
            <button
              type="button"
              class="comments-dialog-close"
              data-close-likes
              aria-label="Close likes"
            >&times;</button>
          </div>
          <%# NOTE: this thread div is .likes-thread ONLY, not also
              .comments-dialog-thread — the comments dialog below shares this
              article and its own .comments-dialog-thread must stay the
              unique match for `article.querySelector('.comments-dialog-
              thread')` (feed.js's per-photo lookups, and
              tests/feed-comment-delete.test.js's own AC5 assertion). The
              shared visual styling (flex/scroll/padding) is still shared —
              see .likes-thread in feed.css's selector list next to
              .comments-dialog-thread, not a duplicated ruleset. %>
          <div class="likes-thread">
            <% if (p.likers.length === 0) { %>
              <p class="muted comments-dialog-empty">No likes yet.</p>
            <% } %>
            <% p.likers.forEach(function (liker) { %>
              <%# data-likes-row is the ONE row-identity hook, present on
                  EVERY row (server-rendered here, or client-inserted by
                  feed.js's selfLikesRowNode) — not just the viewer's own.
                  This is what lets src/public/js/feed.js's updateLikesDialog
                  find and remove a SERVER-rendered row when the viewer
                  unlikes a photo they had already liked before page load
                  (and refuse to duplicate it on a later re-like), issue
                  #890 AC5. %>
              <a class="likes-row" href="/u/<%= liker.id %>" data-likes-row="<%= liker.id %>">
                <% if (liker.avatar_path) { %>
                  <%# lazy: dialogs start closed, and a well-liked page holds
                      hundreds of these — don't fetch them at page load. %>
                  <span class="likes-row-avatar"><img src="/uploads/<%= liker.avatar_path %>" alt="" loading="lazy" decoding="async" /></span>
                <% } else { %>
                  <span class="likes-row-avatar" aria-hidden="true"><%= initials(liker.name) || '?' %></span>
                <% } %>
                <span class="likes-row-name"><%= liker.name || 'Guest' %></span>
                <% if (liker.is_couple) { %>
                  <%# Issue #647: the couple's own row wears the mark, so the
                      gold heart on the photo has a name behind it. %>
                  <%- include('partials/couple-heart-mark', { names: [liker.name || 'Guest'] }) %>
                <% } %>
              </a>
            <% }); %>
          </div>
        </dialog>

        <%# Comments dialog (#248 amendment 2026-07-08): a native <dialog>
            opened via showModal() from src/public/js/feed.js. Top-layer
            rendering escapes .feed-item's paint containment (the round-1
            "fixed" scrim pinned itself to the card, not the viewport),
            centers the panel, makes the background inert (one dialog at a
            time), and closes on Escape natively. The header thumbnail — not
            custom title text — carries the photo context; the title stays
            the generic "<Name>'s photo" (owner note 2026-07-05). %>
        <dialog
          class="comments-dialog"
          id="comments-dialog-<%= p.submission_id %>"
          aria-labelledby="comments-dialog-title-<%= p.submission_id %>"
        >
          <div class="comments-dialog-header">
            <img class="comments-dialog-thumb" src="/thumbs/<%= p.thumb_path %>" alt="" />
            <h2 class="comments-dialog-title" id="comments-dialog-title-<%= p.submission_id %>">
              <%= p.guest_name || 'Guest' %>&rsquo;s photo
            </h2>
            <button
              type="button"
              class="comments-dialog-close"
              data-close-comments
              aria-label="Close comments"
            >&times;</button>
          </div>
          <div class="comments-dialog-thread">
            <% if (commentTotal === 0) { %>
              <p class="muted comments-dialog-empty">No comments yet.</p>
            <% } %>
            <% p.comments.forEach(function (c) { %>
              <div class="feed-comment-item">
                <p class="feed-comment">
                  <a href="/u/<%= c.guest_id %>"><%= c.guest_name || 'Guest' %></a>
                  <%= c.body %>
                </p>
                <%# Own-comment actions menu is a native <details>/<summary>
                    disclosure (issue #338, revised to the kebab pattern
                    2026-07-10) — no JS is required to open it or to reach
                    Delete inside it; JS only enhances it (close-on-outside-
                    tap/after-delete in src/public/js/feed.js). Rendered only
                    for the signed-in guest's OWN comment, and never in the
                    card's clamped preview (that block is above, built from
                    commentPreview, and never touches this dialog markup).
                    data-confirm reuses the app's established
                    destructive-confirm convention (see admin.js and
                    tests/destructive-confirm.test.js); feed.js has no shared
                    admin.js on this page, so it runs the same confirm check
                    itself before the fetch. data-delete-comment is the no-JS
                    form's progressive-enhancement hook. %>
                <% if (c.guest_id === guest.id) { %>
                  <details class="comment-menu">
                    <summary class="comment-menu-trigger" aria-label="Comment actions">&#8943;</summary>
                    <form
                      method="post"
                      action="/p/<%= p.submission_id %>/comments/<%= c.id %>/delete"
                      class="comment-delete-form"
                      data-confirm="Delete this comment? This can't be undone."
                    >
                      <%- include('partials/csrf-field') %>
                      <button
                        type="submit"
                        class="comment-delete"
                        data-delete-comment="<%= c.id %>"
                      >Delete</button>
                    </form>
                  </details>
                <% } %>
              </div>
            <% }); %>
          </div>
          <%# Composer, Instagram pattern: viewer avatar, borderless
              auto-growing textarea (src/public/js/feed.js), Post as a
              plain text control muted while the field is empty. %>
          <form
            method="post"
            action="/p/<%= p.submission_id %>/comments"
            class="comment-form comments-dialog-form"
          >
            <%- include('partials/csrf-field') %>
            <% if (guest.avatar_path) { %>
              <img class="comments-dialog-avatar" src="/uploads/<%= guest.avatar_path %>" alt="" />
            <% } else { %>
              <span class="comments-dialog-avatar comments-dialog-avatar-initials" aria-hidden="true"><%= initials(guest.name) || '?' %></span>
            <% } %>
            <textarea
              name="body"
              rows="1"
              maxlength="<%= commentMaxLength %>"
              placeholder="Add a comment"
              aria-label="Add a comment"
              required
            ></textarea>
            <button type="submit" class="comment-post">Post</button>
          </form>
        </dialog>
      </article>
    <% }); %>
  </div>

  <%# Issue #677: bottom edge for in-place loading of OLDER photos — same
      sentinel/indicator pair as the top edge above. %>
  <% if (olderHref) { %>
    <div class="feed-edge" id="feedEdgeOlder" hidden role="status">
      <span class="feed-edge-ring" aria-hidden="true"></span>
      <span class="visually-hidden">Loading older photos</span>
    </div>
    <div class="feed-sentinel" id="feedSentinelOlder" aria-hidden="true"></div>
  <% } %>

  <%# Scoped-feed bottom back link (issue #952 AC5) — the back link alone,
      no set-label repeat. Sits just above the pager nav, same position the
      phase-1 client mock inserted it at. Gated on isScoped, same as the top
      back link above. %>
  <% if (isScoped) { %>
    <p class="muted">
      <a href="<%= backHref %>"><%= backLabel %></a>
    </p>
  <% } %>

  <%# The pager links are the no-JS fallback (issue #677 keeps them, #194's
      window bound intact): plain navigations to the adjacent window. With
      JavaScript on, feed-scroll.js reads its hrefs as the source of truth,
      hides this nav, and loads the same windows in place instead. The
      page-link-newer/-older classes are that script's direction hooks. %>
  <% if (newerHref || olderHref) { %>
    <nav class="pagination" aria-label="Feed pages">
      <% if (newerHref) { %>
        <a class="page-link page-link-newer" href="<%= newerHref %>">&larr; Newer</a>
      <% } %>
      <% if (olderHref) { %>
        <a class="page-link page-link-older" href="<%= olderHref %>">Older &rarr;</a>
      <% } %>
    </nav>
  <% } %>

  <script src="/js/photo-owner-menu.js" defer></script>
  <script src="/js/lightbox.js" defer></script>
  <% if (newerHref || olderHref) { %>
    <script src="/js/feed-scroll.js" defer></script>
  <% } %>

<%- include('partials/footer') %>
