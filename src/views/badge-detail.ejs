<%# src/views/badge-detail.ejs — issue #488
    GET /badge/:code. `isTaskMaster` (computed once by the route, never
    re-derived here) picks the rendered shape:
      - false: system badge (auto/special/metric/transferable) — shared
        catalog description + a plain holder list, no per-award data.
      - true:  Task Master badge (a task's own 'custom' badge) — one row per
        award with that award's points, note, and earning-photo thumbnail
        (thumbnail only when the earning photo is still visible — AC4).

    Issue #954 AC5: the earning-photo thumbnail opens the feed scoped to this
    badge's holder set (badgeScopeToken, the route's own feed.scopeToken()
    result; this view never hand-builds the 'b<id>' token), carrying
    origin=badge so the scoped feed's back link returns here.

    This row is NOT rendered through partials/gallery-tile (issue #954 plan
    step 6's own evaluation): the tile is a 400x400 <figure> block meant for
    a .gallery-grid, with crown/medal overlay slots that have no meaning on a
    60x60 award-row thumbnail sitting inline in a flex row beside the award's
    name/points/note (.award-row-thumb-link, admin.css). Reusing it would mean
    adding width/height overrides the partial does not support today, plus
    stripping overlay markup that would only ever render empty here: a
    bigger, riskier change than this row's own href/scope wiring, so the
    one-off markup stays. Only its link target changed. %>
<%- include('partials/head') %>
<%- include('partials/header') %>

  <header class="badge-detail-header">
    <%- include('partials/badge-art', { badge: badge, imgClass: 'badge-detail-art', width: 120, height: 120 }) %>
    <h1 class="badge-detail-name"><%= badge.name %></h1>
    <% if (badge.description) { %>
      <p class="badge-detail-desc"><%= badge.description %></p>
    <% } %>
  </header>

  <% if (isTaskMaster) { %>
    <section class="badge-award-section">
      <h2 class="badge-detail-label">Awards<% if (holders.length > 0) { %> <span class="badge-detail-count"><%= holders.length %></span><% } %></h2>
      <% if (holders.length === 0) { %>
        <p class="muted">No one has earned this badge yet.</p>
      <% } else { %>
        <ul class="award-row-list">
          <% holders.forEach(function (h) { %>
            <li class="award-row">
              <div class="award-row-body">
                <div class="award-row-head">
                  <a class="award-row-name" href="/u/<%= h.guest_id %>"><%= h.guest_name || 'Guest' %></a>
                  <span class="award-row-points">+<%= h.points %> pts</span>
                </div>
                <% if (h.note) { %>
                  <p class="award-row-note"><%= h.note %></p>
                <% } %>
              </div>
              <% if (h.submission_id && h.thumb_path) { %>
                <%
                  /* Built as one JS string, then emitted through the
                     HTML-escaping output tag, so the '&' query separators
                     escape to '&amp;', the same convention
                     partials/gallery-tile.ejs's own href follows (issue
                     #952 AC2), rather than mixing literal '&' characters
                     into the template's raw HTML source. */
                  var thumbHref = '/feed?from=' + h.submission_id + '&scope=' + badgeScopeToken +
                    '&origin=badge#photo-' + h.submission_id;
                %>
                <a class="award-row-thumb-link"
                   href="<%= thumbHref %>"
                   aria-label="View the earning photo">
                  <img class="award-row-thumb"
                       src="/thumbs/<%= h.thumb_path %>"
                       alt=""
                       width="60" height="60"
                       loading="lazy" />
                </a>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  <% } else { %>
    <section class="badge-holder-section">
      <h2 class="badge-detail-label">Holders<% if (holders.length > 0) { %> <span class="badge-detail-count"><%= holders.length %></span><% } %></h2>
      <% if (holders.length === 0) { %>
        <p class="muted">No one has earned this badge yet.</p>
      <% } else { %>
        <ul class="holder-list">
          <% holders.forEach(function (h) { %>
            <li class="holder-row">
              <a href="/u/<%= h.guest_id %>"><%= h.guest_name || 'Guest' %></a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  <% } %>

<%- include('partials/footer') %>
